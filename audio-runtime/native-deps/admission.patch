+/* The embedding host authenticates and accepts in the executor's SELinux domain. */
+SPA_EXPORT
+struct pw_impl_client *magicdesk_native_accept(struct pw_protocol *protocol, int fd)
+{
+	struct pw_protocol_server *server;
+	if (protocol == NULL || spa_list_is_empty(&protocol->server_list)) {
+		close(fd);
+		errno = ENOTCONN;
+		return NULL;
+	}
+	server = spa_list_first(&protocol->server_list, struct pw_protocol_server, link);
+	struct server *s = SPA_CONTAINER_OF(server, struct server, this);
+	struct client_data *client = client_new(s, fd);
+	if (client == NULL) return NULL;
+	return client->client;
+}
