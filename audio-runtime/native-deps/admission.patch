+SPA_EXPORT
+int magicdesk_pulse_accept(struct pw_protocol_pulse *pulse, int fd, void *owner)
+{
+	struct impl *impl = (struct impl *)pulse;
+	if (spa_list_is_empty(&impl->servers)) { close(fd); return -ENOTCONN; }
+	return accept_client(spa_list_first(&impl->servers, struct server, link), fd, owner);
+}
+
+SPA_EXPORT
+void magicdesk_pulse_disconnect(struct pw_protocol_pulse *pulse, void *owner)
+{
+	struct impl *impl = (struct impl *)pulse;
+	struct server *server;
+	struct client *client, *next;
+	spa_list_for_each(server, &impl->servers, link)
+		spa_list_for_each_safe(client, next, &server->clients, link)
+			if (client->embedding_owner == owner) client_free(client);
 }
 
