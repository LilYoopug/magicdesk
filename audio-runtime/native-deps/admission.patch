+static void on_connect(void *data, int fd, uint32_t mask)
+{
+	struct server *server = data;
+	int client_fd = accept4(fd, NULL, NULL, SOCK_CLOEXEC);
+	if (client_fd < 0) {
+		if ((errno == EMFILE || errno == ENFILE) && server->n_clients > 0) {
+			pw_loop_update_io(server->impl->loop, server->source, server->source->mask & ~SPA_IO_IN);
+			server->wait_clients++;
+		}
+		return;
+	}
+	accept_client(server, client_fd, NULL);
+}
